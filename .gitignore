# ==============================================================================
# WordEase — Git Ignore Rules
# ==============================================================================

# OS & System Files
# -----------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Node.js & Dependencies
# ----------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Metro, Bundler & Compilers
# --------------------------
.metro-health-check*
.metro/
*.jsbundle
*.hbc
.cache/
.eslintcache
*.tsbuildinfo
.tmp/
tools/.cache/

# Android / Gradle Build Artifacts
# --------------------------------
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
android/.kotlin/
.cxx/
.gradle/
build/
*.hprof
*.apk
*.aab
*.ap_
*.dex
local.properties

# Security & Keystores (Never commit release signing keys)
# -------------------------------------------------------
*.keystore
*.jks
!debug.keystore
!android/app/debug.keystore

# iOS / Xcode / CocoaPods
# -----------------------
ios/Pods/
ios/build/
**/Pods/
/vendor/bundle/
.bundle/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcuserstate
**/.xcode.env.local

# IDEs & Editors
# --------------
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# Environment Variables & Secrets
# -------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Testing & Coverage
# ------------------
/coverage/
.nyc_output/

# Fastlane
# --------
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Yarn
# ----
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
